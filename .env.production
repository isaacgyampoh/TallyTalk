# Committed on purpose so Vercel builds with no manual env setup.
# The Supabase anon key is PUBLIC by design — it ships in the browser bundle
# regardless, and access is enforced by Row-Level Security, not by hiding it.

# --- NO BACKEND IS CONFIGURED RIGHT NOW ---
# The project these values pointed at (apbdqgussaylxilqjowa) no longer exists —
# its hostname does not resolve. Shipping them made production offer a phone
# sign-in that could never succeed, so they are parked here instead.
#
# With both values absent the app boots in Preview mode (local sample data, no
# network), which is the documented fallback and what the live site now runs.
#
# To go live again: create a Supabase project, run every file in
# supabase/migrations in order, then uncomment these two lines with the new
# Project URL and anon key from Project Settings -> API.
#
# VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

VITE_APP_NAME=TaskTally
