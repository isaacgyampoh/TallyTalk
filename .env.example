# --- Supabase (safe to expose to the browser) ---
# Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Project Settings -> API -> Project API keys -> anon / publishable key
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: display name shown in the UI (defaults to "TallyTalk")
VITE_APP_NAME=TallyTalk

# NOTE: The Arkesel API key is a SECRET and must NOT go here.
# It is stored server-side as a Supabase secret used by the send-sms-hook
# Edge Function:  supabase secrets set ARKESEL_API_KEY=... ARKESEL_SENDER_ID=TallyTalk
