<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Custom scheme: works immediately, no server verification.
                 Used by anything the app itself emits. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tasktally" />
            </intent-filter>

            <!-- App Links: a tally-talk.vercel.app link opens the app rather
                 than the browser. autoVerify requires assetlinks.json served
                 at /.well-known/ on that host, which is why the file exists. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="tally-talk.vercel.app" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required from Android 13 (API 33). Without this the runtime permission
         request is a no-op and every notification is silently dropped. The app
         targets API 36, so it is mandatory. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets a notification channel vibrate; the user still controls it from
         the channel's own system settings. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Voice notes record through getUserMedia in the WebView. Without this
         the request is refused and recording fails on device, while working
         fine in a desktop browser. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- A microphone is not required to use TaskTally; without this the Play
         Store would hide the app from devices that lack one. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
