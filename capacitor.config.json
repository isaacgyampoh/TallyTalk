{
  "appId": "com.tasktally.app",
  "appName": "TaskTally",
  "webDir": "dist",
  "backgroundColor": "#ffffff",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "backgroundColor": "#6600FF",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "Keyboard": { "resize": "native" },
    "PushNotifications": { "presentationOptions": ["badge", "sound", "alert"] }
  }
}
